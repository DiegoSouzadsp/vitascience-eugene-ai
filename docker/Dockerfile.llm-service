# Dockerfile for LLM Embedding Service - Lightweight version
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install only essential Python dependencies for LLM service
RUN pip install --no-cache-dir \
    aiohttp==3.9.1 \
    fastapi==0.104.1 \
    uvicorn[standard]==0.24.0 \
    pydantic==2.5.0 \
    anthropic==0.29.0 \
    openai==1.50.0 \
    python-dotenv==1.0.0

# Copy source code
COPY src/ ./src/

# Set Python path
ENV PYTHONPATH=/app

# Expose port
EXPOSE 9000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:9000/health || exit 1

# Command to run the application
CMD ["python", "src/llm_embedding_api.py"]
# ========================================
# LLM CONFIGURATION
# ========================================
# Choose your LLM provider: openai | anthropic | gemini | ollama
LLM_PROVIDER=openai

# API Keys (only configure the one you're using)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (optional - defaults provided)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_MODEL=gemini-1.5-pro
OLLAMA_MODEL=llama3
OLLAMA_BASE_URL=http://localhost:11434

# Database Configuration
POSTGRES_DB=eugene_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@localhost:5432/eugene_rag

# N8N Configuration (Remote Instance)
N8N_BASE_URL=http://IP_DO_NOTEBOOK:5678
N8N_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJlY2YwNGE5ZC05MTg5LTQ5ZGMtOGEwNS02MjlhMzAyMWZhOWMiLCJpc3MiOiJuOG4iLCJhdWQiOiJwdWJsaWMtYXBpIiwiaWF0IjoxNzU4MzAzNjk1fQ.9g4Hj6VX-fHblyvqAv0o9Wfx34dX6b6Wy-h2_Lqvgww
N8N_WEBHOOK_URL=http://IP_DO_NOTEBOOK:5678/webhook

# RAG API Configuration
RAG_API_PORT=8000
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
EMBEDDING_MODEL=text-embedding-3-large

# Performance Settings
MAX_TOKENS=4000
TEMPERATURE=0.1
MAX_CONCURRENT_REQUESTS=5

# Health Tech Specific
ANVISA_COMPLIANCE=true
BRAZILIAN_MARKET=true
SUPPLEMENT_FOCUS=true